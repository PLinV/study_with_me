# Copie ce fichier en .env et remplis les valeurs.

# Client ID de ton app sur https://developer.spotify.com/dashboard
# Redirect URI à déclarer là-bas : http://127.0.0.1:8080/callback
SPOTIFY_CLIENT_ID=

# Base de données (utilisée uniquement à l'intérieur de docker compose)
POSTGRES_USER=pomodoro
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pomodoro

# Fuseau horaire utilisé pour les stats "aujourd'hui" / "cette semaine"
APP_TZ=Europe/Paris

# Port local de l'app (si tu le changes, change aussi la Redirect URI Spotify)
WEB_PORT=8080
