{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "types": [
      "vite/client"
    ],
    "jsx": "preserve"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue"
  ]
}
