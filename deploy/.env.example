# Copie ce fichier en .env à côté de docker-compose.yml et remplis les valeurs.

# Version des images : latest (dernier commit sur main), ou une version précise comme 1.0.0
STUDY_WITH_ME_VERSION=latest

# Mot de passe de la base (obligatoire, choisis-en un vrai)
POSTGRES_PASSWORD=
POSTGRES_USER=pomodoro
POSTGRES_DB=pomodoro

# Client ID de ton app sur https://developer.spotify.com/dashboard
# Spotify n'accepte que https (ou 127.0.0.1) : déclare l'adresse HTTPS de ton homelab,
# par exemple https://study.mon-homelab.fr/callback
SPOTIFY_CLIENT_ID=

# Fuseau horaire pour les stats "aujourd'hui" / "cette semaine"
APP_TZ=Europe/Paris

# Adresse et port d'écoute. 0.0.0.0 = accessible depuis le réseau ;
# mets 127.0.0.1 si un reverse proxy (Caddy, Traefik…) tourne sur la même machine.
WEB_BIND=0.0.0.0
WEB_PORT=8080
